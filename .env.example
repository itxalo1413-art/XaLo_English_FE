## Frontend env
# Local dev: use Vite proxy (recommended) by leaving VITE_API_URL empty
# Or point directly to Nest backend:
# VITE_API_URL=http://localhost:3001/api/v1

# Canonical URL for SEO (Open Graph, canonical links). Production:
# VITE_SITE_URL=https://www.xalo.edu.vn

# Backend sitemap/prerender (set on server / in backend/.env):
# SITE_URL=https://www.xalo.edu.vn

